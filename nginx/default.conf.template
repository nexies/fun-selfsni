map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

log_format selfsni
    '$proxy_protocol_addr - $remote_user [$time_local] '
    '"$request" $status $body_bytes_sent '
    '"$http_referer" "$http_user_agent"';

server {
    # Внутри контейнера Nginx слушает 443.
    # На хосте Docker публикует его только как 127.0.0.1:${SELFSNI_PORT:-9000}.
    listen 443 ssl proxy_protocol;
    http2 on;

    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305';
    ssl_session_cache shared:SSL:1m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Reality/Xray должен передавать PROXY protocol: xver=1.
    real_ip_header proxy_protocol;

    # В нативной конфигурации из туториала источником является localhost.
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;

    set_real_ip_from 0.0.0.0;

    # При Docker port publishing соединение приходит через bridge-сеть.
    # Значение должно совпадать с DOCKER_SUBNET в .env.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};

    access_log /var/log/nginx/access.log selfsni;

    location / {
        proxy_pass http://${UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

#
# Обычный локальный HTTPS-вход
#
server {
    listen 444 ssl;
    http2 on;

    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:1m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log /var/log/nginx/local-access.log;

    location / {
        proxy_pass http://${UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
