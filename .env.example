# Имя каталога сертификата внутри /etc/letsencrypt/live/.
# Иногда оно выглядит как example.com-0001.
CERT_NAME=example.com

# Домен без схемы и порта. Он же указывается в поле SNI Reality.
SERVER_NAME=example.com

# Каталог Certbot на хосте.
CERTBOT_DIR=/etc/letsencrypt

# Локальный SelfSNI-порт на хосте.
# В Reality/3x-ui: DEST/Target = 127.0.0.1:9000
SELFSNI_PORT=9000

# Локальный HTTPS порт для доступа к сайту с 127.0.0.1
LOCAL_HTTPS_PORT=9001

# Выделенная Docker bridge-сеть.
# Если меняете подсеть, поменяйте TRUSTED_PROXY_CIDR вместе с ней.
DOCKER_SUBNET=172.31.250.0/24
DOCKER_GATEWAY=172.31.250.1
TRUSTED_PROXY_CIDR=172.31.250.0/24